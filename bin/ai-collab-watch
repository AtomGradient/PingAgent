#!/usr/bin/env bash
# ai-collab-watch <role> <mailbox-dir>
# 监听 .ai-mailbox/inbox/<role>/ 的新消息文件，用 osascript 把短通知注入本 pane。
# 通常由 ai-pane-register 自动启动，不需要手动跑。
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/ai-terminal-common.sh"

ROLE="${1:?usage: ai-collab-watch <role> <mailbox>}"
MAILBOX="${2:?usage: ai-collab-watch <role> <mailbox>}"
OSASCRIPT_BIN="${AI_COLLAB_OSASCRIPT_BIN:-/usr/bin/osascript}"

if [[ ! -x "$OSASCRIPT_BIN" ]]; then
  echo "osascript executable not found: $OSASCRIPT_BIN" >&2
  exit 1
fi

PANES_FILE="$MAILBOX/.panes/$ROLE.json"
if [[ ! -f "$PANES_FILE" ]]; then
  echo "Pane not registered: $PANES_FILE not found" >&2
  exit 1
fi

SESSION_UUID=$(ai_pane_field "$PANES_FILE" session_uuid)
# Records written before Terminal support have no backend field.
TERMINAL_BACKEND=$(ai_pane_field "$PANES_FILE" terminal)
TERMINAL_BACKEND="${TERMINAL_BACKEND:-iterm2}"
TERMINAL_TTY=""
TERMINAL_WINDOW_ID=""
case "$TERMINAL_BACKEND" in
  iterm2)
    TERMINAL_TTY=$(ai_pane_field "$PANES_FILE" terminal_tty)
    TERMINAL_OWNER_PID=$(ai_pane_field "$PANES_FILE" terminal_owner_pid)
    TERMINAL_OWNER_FINGERPRINT=$(ai_pane_field "$PANES_FILE" terminal_owner_fingerprint)
    ;;
  terminal|ghostty)
    TERMINAL_TTY=$(ai_pane_field "$PANES_FILE" terminal_tty)
    TERMINAL_OWNER_PID=$(ai_pane_field "$PANES_FILE" terminal_owner_pid)
    TERMINAL_OWNER_FINGERPRINT=$(ai_pane_field "$PANES_FILE" terminal_owner_fingerprint)
    if [[ ! "$TERMINAL_TTY" =~ ^/dev/ttys[0-9]+$ ||
          ! "$TERMINAL_OWNER_PID" =~ ^[0-9]+$ || -z "$TERMINAL_OWNER_FINGERPRINT" ]]; then
      echo "Invalid $TERMINAL_BACKEND session registration in $PANES_FILE; re-run ai-pane-register." >&2
      exit 1
    fi
    if [[ "$TERMINAL_BACKEND" == "terminal" ]]; then
      TERMINAL_WINDOW_ID=$(ai_pane_field "$PANES_FILE" terminal_window_id)
      if [[ ! "$TERMINAL_WINDOW_ID" =~ ^[0-9]+$ ]]; then
        echo "Invalid Terminal tab registration in $PANES_FILE; re-run ai-pane-register." >&2
        exit 1
      fi
    else
      GHOSTTY_SURFACE_ID=$(ai_pane_field "$PANES_FILE" ghostty_surface_id)
      GHOSTTY_TERMINAL_ID=$(ai_pane_field "$PANES_FILE" ghostty_terminal_id)
      if ! ai_valid_ghostty_surface_id "$GHOSTTY_SURFACE_ID" ||
         ! ai_valid_ghostty_terminal_id "$GHOSTTY_TERMINAL_ID" ||
         [[ "$SESSION_UUID" != "ghostty:$GHOSTTY_SURFACE_ID" ]]; then
        echo "Invalid Ghostty pane registration in $PANES_FILE; re-run ai-pane-register." >&2
        exit 1
      fi
    fi
    ;;
  *) echo "Unsupported terminal backend: $TERMINAL_BACKEND" >&2; exit 1 ;;
esac

if [[ -z "$SESSION_UUID" || "$SESSION_UUID" == "null" ]]; then
  echo "Cannot read session_uuid from $PANES_FILE" >&2
  exit 1
fi

INBOX="$MAILBOX/inbox/$ROLE"
mkdir -p "$INBOX"
INBOX_REAL="$(cd "$INBOX" && pwd -P)"

# 收到信号时把 fswatch 等子进程一起带走（避免孤儿）。
# 不 trap HUP：让 nohup 启动的 watcher 在父 shell 退出时正常存活。
trap 'pkill -P $$ 2>/dev/null || true' EXIT TERM INT

log() {
  echo "[$(date "+%Y-%m-%d %H:%M:%S")] $*"
}

# 用 osascript 把一行字注入到指定 session（作为用户输入，自动提交）。
# 关键点（经过实测踩坑得出）：
# 1. 单个大 -e + 块式 tell（多 -e 拼 + `tell ... to ...` 会触发 -2741 syntax error）。
# 2. 末尾用 CR (\r, ASCII 13)。Ink/blessed 这类 TUI（如 Google Antigravity CLI、Codex）把 \r 当
#    Enter，把 \n 当"换行字符"——单纯 \n 只会让文字进输入框但不提交。
# 3. **正文和 CR 必须分两次 write text 发**。如果 `write text (msg & CR) newline false`
#    一起发，iTerm2 会把整段当作一次 bracketed paste（\e[200~...\e[201~ 包起来），
#    Ink TUI 在 paste 模式里把所有字符（含尾部 CR）当文本内容插入输入框、不触发 Enter。
#    实测：单独发一个孤立 CR 就能把卡住的输入框提交，确认了 paste 抑制是根因。
#    分两次发使第二次 write 不会被裹进同一个 paste，CR 作为独立字节流到达就当 Enter。
INJECT_ERROR=""

inject() {
  local msg="$1" output exit_code script
  local -a target_args

  INJECT_ERROR=""
  if [[ "$TERMINAL_BACKEND" == "terminal" || "$TERMINAL_BACKEND" == "ghostty" ]]; then
    if [[ "$(ai_process_fingerprint "$TERMINAL_OWNER_PID" 2>/dev/null || true)" != "$TERMINAL_OWNER_FINGERPRINT" ]]; then
      INJECT_ERROR="session_not_found"
      return 1
    fi
  fi
  if [[ "$TERMINAL_BACKEND" == "terminal" ]]; then
    # Terminal's do script sends the text plus CR directly to the tab's PTY,
    # including when a TUI is running. No focus change or UI keystrokes needed.
    # Both window ID and TTY must match; never fall back to the selected tab.
    script='
on run argv
  set targetWindow to item 1 of argv as integer
  set targetTTY to item 2 of argv
  set targetMsg to item 3 of argv
  if not (application "Terminal" is running) then return "session not found: " & targetTTY
  tell application "Terminal"
    repeat with aWindow in windows
      if id of aWindow is targetWindow then
        repeat with aTab in tabs of aWindow
          if tty of aTab is targetTTY then
            do script targetMsg in aTab
            return "ok"
          end if
        end repeat
      end if
    end repeat
  end tell
  return "session not found: " & targetTTY
end run
'
    target_args=("$TERMINAL_WINDOW_ID" "$TERMINAL_TTY" "$msg")
  elif [[ "$TERMINAL_BACKEND" == "ghostty" ]]; then
    # Ghostty's input text is a paste. Submit with a separate key event so
    # bracketed-paste-aware TUIs treat Enter as submission, not pasted text.
    script='
on run argv
  set targetID to item 1 of argv
  set targetTTY to item 2 of argv
  set targetMsg to item 3 of argv
  if not (application "Ghostty" is running) then return "session not found: " & targetID
  tell application "Ghostty"
    repeat with aTerminal in terminals
      if id of aTerminal is targetID and tty of aTerminal is targetTTY then
        input text targetMsg to aTerminal
        delay 0.05
        send key "enter" to aTerminal
        return "ok"
      end if
    end repeat
  end tell
  return "session not found: " & targetID
end run
'
    target_args=("$GHOSTTY_TERMINAL_ID" "$TERMINAL_TTY" "$msg")
  else
    script='
on run argv
  set targetID to item 1 of argv
  set targetMsg to item 2 of argv
  set CR to (ASCII character 13)
  tell application "iTerm2"
    repeat with aWindow in windows
      repeat with aTab in tabs of aWindow
        repeat with aSession in sessions of aTab
          if id of aSession is targetID then
            tell aSession
              write text targetMsg newline false
              delay 0.05
              write text CR newline false
            end tell
            return "ok"
          end if
        end repeat
      end repeat
    end repeat
    return "session not found: " & targetID
  end tell
end run
'
    target_args=("$SESSION_UUID" "$msg")
  fi
  if output=$("$OSASCRIPT_BIN" -e "$script" -- "${target_args[@]}" 2>&1); then
    exit_code=0
  else
    exit_code=$?
  fi

  if [[ "$exit_code" -eq 0 && "$output" == "ok" ]]; then
    return 0
  fi

  if [[ "$output" == *"session not found:"* ]]; then
    INJECT_ERROR="session_not_found"
  elif [[ "$output" == *"(-1743)"* || "$output" == *"error number -1743"* ]]; then
    INJECT_ERROR="automation_denied_-1743"
  elif [[ "$exit_code" -ne 0 ]]; then
    INJECT_ERROR="osascript_exit_$exit_code"
  else
    INJECT_ERROR="unexpected_osascript_response"
  fi

  return 1
}

# 解析 frontmatter 字段
extract_field() {
  local file="$1" key="$2"
  # 只在前 30 行的 frontmatter 区域查找
  head -n 30 "$file" | sed -n "s/^${key}: *\(.*\) *$/\1/p" | head -n 1
}

process_file() {
  local path="$1"
  [[ -f "$path" ]] || return 0
  local fname
  fname=$(basename "$path")

  # 跳过 dot 文件、tmp 文件、非 .md、已处理过的
  case "$fname" in
    .*) return 0 ;;
    *.md) ;;
    *) return 0 ;;
  esac
  if [[ -f "${path}.dispatched" ]]; then
    return 0
  fi

  local sender kind id reply_to
  sender=$(extract_field "$path" from)
  kind=$(extract_field "$path" kind)
  id=$(extract_field "$path" id)
  reply_to=$(extract_field "$path" reply_to)

  # 计算项目根（mailbox 的父目录）
  local project_root rel_path
  project_root=$(dirname "$MAILBOX")
  rel_path=".ai-mailbox/inbox/$ROLE/$fname"

  # 构造给 AI 的通知（一行，避免在 TUI 输入框里换行）
  local notif
  if [[ -n "$reply_to" ]]; then
    notif="[ai-collab 收信] from=$sender to=$ROLE kind=$kind id=$id reply_to=$reply_to | 请 Read $rel_path 并按其中说明处理；这是对你之前消息(id=$reply_to)的回复"
  else
    notif="[ai-collab 收信] from=$sender to=$ROLE kind=$kind id=$id | 请 Read $rel_path 并按其中说明处理；处理完用 ai-ping $sender --reply-to $id --file <你的回复.md>"
  fi

  log "dispatching: $fname (from=$sender, kind=$kind)"
  if inject "$notif"; then
    if touch "${path}.dispatched" 2>/dev/null; then
      log "delivery confirmed: $fname"
    else
      log "WARNING: injection succeeded but dispatched sidecar write failed for $fname"
    fi
  else
    log "WARNING: inject failed for $fname reason=${INJECT_ERROR:-unknown}; message remains undispatched"
  fi
}

log "ai-collab-watch starting: role=$ROLE mailbox=$MAILBOX terminal=$TERMINAL_BACKEND session=$SESSION_UUID"

# macOS Terminal 与 iTerm2 的标题在 ai-pane-register 退出回到 shell 提示符（如 Oh My Zsh precmd）
# 或启动 TUI 时会被 OSC 0/1/2 覆盖；Ghostty 的 name override 原生持久无需轮询。
if [[ "${AI_COLLAB_KEEP_TITLE:-}" == "1" && ( "$TERMINAL_BACKEND" == "terminal" || "$TERMINAL_BACKEND" == "iterm2" ) ]]; then
  (
    for delay_sec in 0.6 0.8 1.0 1.5 2.0; do
      sleep "$delay_sec"
      if [[ -n "${TERMINAL_OWNER_PID:-}" && -n "${TERMINAL_OWNER_FINGERPRINT:-}" ]]; then
        [[ "$(ai_process_fingerprint "$TERMINAL_OWNER_PID" 2>/dev/null || true)" == "$TERMINAL_OWNER_FINGERPRINT" ]] || exit 0
      fi
      ai_set_pane_title "$ROLE" >/dev/null 2>&1 || true
    done
    while true; do
      sleep 5
      if [[ -n "${TERMINAL_OWNER_PID:-}" && -n "${TERMINAL_OWNER_FINGERPRINT:-}" ]]; then
        [[ "$(ai_process_fingerprint "$TERMINAL_OWNER_PID" 2>/dev/null || true)" == "$TERMINAL_OWNER_FINGERPRINT" ]] || exit 0
      fi
      ai_set_pane_title "$ROLE" >/dev/null 2>&1 || exit 0
    done
  ) &
fi

# 启动时扫描一次（处理 watcher 启动前已到达的消息）
for f in "$INBOX"/*.md; do
  [[ -f "$f" ]] || continue
  process_file "$f"
done

# 主循环：fswatch 优先，否则 polling
if command -v fswatch >/dev/null 2>&1; then
  log "using fswatch (event-driven)"
  # -0: NUL-terminated paths; 监听整个 inbox 目录
  while IFS= read -r -d "" path; do
    # fswatch (macOS FSEvents) 返回物理路径；同时兼容符号链接路径与真实路径
    if [[ "$path" == "$INBOX"/*.md || "$path" == "$INBOX_REAL"/*.md ]]; then
      process_file "$path"
    fi
  done < <(fswatch -0 "$INBOX")
else
  log "fswatch not found, falling back to 1s polling. Install: brew install fswatch"
  while true; do
    for f in "$INBOX"/*.md; do
      [[ -f "$f" ]] || continue
      process_file "$f"
    done
    sleep 1
  done
fi
