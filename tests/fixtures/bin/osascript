#!/usr/bin/env bash
set -euo pipefail

: "${FAKE_OSASCRIPT_CALLS:?FAKE_OSASCRIPT_CALLS is required}"
for arg in "$@"; do
  printf 'arg=%s\n' "$arg" >> "$FAKE_OSASCRIPT_CALLS"
done

script="${2:-}"
mode="${FAKE_OSASCRIPT_MODE:-success}"
if [[ "$script" == *"set custom title"* || "$script" == *"set name override"* || "$script" == *"set name of aSession"* ]]; then
  if [[ -n "${FAKE_OSASCRIPT_TITLE_MODE:-}" ]]; then
    mode="$FAKE_OSASCRIPT_TITLE_MODE"
  else
    case "$mode" in
      terminal_registration|ghostty_registration|success)
        mode="success"
        ;;
    esac
  fi
fi

case "$mode" in
  terminal_registration)
    printf '42\n'
    ;;
  ghostty_registration)
    printf '%s\n' "${FAKE_GHOSTTY_TERMINAL_ID:-B36E598A-A1F3-41F7-A753-128CA5A4A351}"
    ;;
  success)
    printf 'ok\n'
    ;;
  session_missing)
    printf 'session not found: fake-session\n'
    ;;
  tcc_denied)
    printf 'execution error: Not authorized to send Apple events to iTerm2. (-1743)\n' >&2
    exit 1
    ;;
  unexpected_success)
    printf 'unexpected response\n'
    ;;
  *)
    printf 'unknown fake mode: %s\n' "$FAKE_OSASCRIPT_MODE" >&2
    exit 2
    ;;
esac
